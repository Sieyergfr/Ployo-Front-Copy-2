generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  HR
  EMPLOYEE
}

enum InvitationRole {
  ADMIN
  HR
  EMPLOYEE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum TenantPlan {
  starter
  professional
  business
}

enum BillingCycle {
  monthly
  yearly
}

enum PermissionScope {
  own
  team
  all
  assigned
}

enum PermissionLevel {
  none
  read
  write
  admin
}

enum LocationStatus {
  active
  inactive
}

/// Für die Feiertagsberechnung (lib/german-holidays.ts) — welche
/// länderspezifischen Feiertage zusätzlich zu den neun bundeseinheitlichen
/// für einen Standort gelten. `null` (kein Bundesland hinterlegt) bedeutet
/// nur die bundeseinheitlichen Feiertage, nie "keine Feiertage" (Audit-Finding M01/M03).
enum Bundesland {
  BW
  BY
  BE
  BB
  HB
  HH
  HE
  MV
  NI
  NW
  RP
  SL
  SN
  ST
  SH
  TH
}

enum EmployeeStatus {
  active
  vacation
  absent
  /// Beschaeftigung beendet (ueber den Ausscheiden-Button gesetzt) - persistenter, autoritativer Zustand, nicht live aus Urlaub/Krankheit ableitbar.
  former
}

enum SicknessStatus {
  open
  closed
}

enum FileStatus {
  active
  deleted
  replaced
}

enum ContractStatus {
  draft
  active
  terminated
  expired
  inactive
}

enum PayrollStatementStatus {
  available
  corrected
}

enum InfoRequestStatus {
  open
  uploaded
  review
  cancelled
}

enum ReminderPriority {
  urgent
  important
  normal
}

enum ReminderStatus {
  open
  done
}

enum Weekday {
  Mo
  Di
  Mi
  Do
  Fr
  Sa
  So
}

enum VacationRequestStatus {
  pending
  approved
  rejected
}

enum WishFreeRequestStatus {
  open
  approved
  rejected
}

enum ShiftWeekStatus {
  draft
  published
}

enum FileFolderStatus {
  active
  inactive
}

model User {
  id                    String                       @id @default(cuid())
  name                  String
  email                 String                       @unique
  emailVerified         Boolean                      @default(false)
  image                 String?
  twoFactorEnabled      Boolean                      @default(false)
  scheduledDeletionAt   DateTime?
  termsAcceptedAt       DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  accounts              Account[]
  memberships           TenantMembership[]
  sessions              Session[]
  pushSubscriptions     PushSubscription[]
  twoFactor             TwoFactor[]
  preference            UserPreference?
  employeeNotifications TenantEmployeeNotification[]
  appPopupDismissals    AppPopupDismissal[]
  employeeRecords       TenantEmployee[]

  @@map("user")
}

/**
 * Persönliche Einstellungen. `language` steuert die next-intl-Locale
 * (lib/i18n.ts, i18n/request.ts) — bisher aber nur für einzelne, schon
 * übersetzte Oberflächenteile spürbar (z. B. die Konto-Einstellungskarte),
 * da noch nicht die gesamte App auf Katalog-Strings umgestellt ist.
 * Zeitzone und Datumsformat werden gespeichert, wirken sich aber noch nicht
 * auf die Darstellung aus. Startseite wird beim Anmelden tatsächlich
 * angewendet.
 */
model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  language             String   @default("de")
  timezone             String   @default("Europe/Berlin")
  startPage            String   @default("overview")
  dateFormat           String   @default("dd.mm.yyyy")
  /// Persönliche Opt-out-Ebene oberhalb der mandantenweiten Alerts
  /// (TenantSettings.absenceAlerts/shiftAlerts) — steuert, ob DIESER Nutzer
  /// Urlaubs-Entscheidungs- bzw. Schichtänderungs-Benachrichtigungen (E-Mail
  /// + In-App) erhält. Für die Mitarbeiter-App (Profil-Screen).
  notifyVacationEvents Boolean  @default(true)
  notifyShiftEvents    Boolean  @default(true)
  pushEnabled          Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * better-auth `twoFactor`-Plugin: TOTP-Secret + Backup-Codes je Nutzer.
 */
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("twoFactor")
}

/**
 * Vorbereitung für Push-Benachrichtigungen aus einer künftigen mobilen App.
 * Die App registriert hier ihr Push-Token; solange keine App existiert,
 * bleibt die Tabelle leer und der Push-Kanal in lib/notifications ist ein
 * reiner No-Op-Stub.
 */
/// Popup in der Mitarbeiter-App (Bottom-Sheet, lib/app-popups.ts). Ployo-weit,
/// nicht mandantengebunden. Gepflegt vorerst per `scripts/app-popup.ts`,
/// später über ein Ployo-Admin-Dashboard. Mehrere aktive Popups zeigt die App
/// nacheinander (höhere `priority` zuerst), jedes pro Nutzer nur bis zum
/// Schließen.
model AppPopup {
  id            String              @id @default(cuid())
  title         String
  body          String
  /// Englische Fassung — fehlt sie, zeigt die App auch englischen Nutzern Deutsch.
  titleEn       String?
  bodyEn        String?
  imageUrl      String?
  buttonLabel   String?
  buttonLabelEn String?
  /// `https://…` öffnet den Browser, `/pfad` einen Screen in der App.
  buttonUrl     String?
  active        Boolean             @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  priority      Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  dismissals    AppPopupDismissal[]

  @@index([active, priority])
}

model AppPopupDismissal {
  id          String   @id @default(cuid())
  popupId     String
  userId      String
  dismissedAt DateTime @default(now())
  popup       AppPopup @relation(fields: [popupId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([popupId, userId])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  platform  String   @default("web")
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model RateLimit {
  id          String  @id @default(cuid())
  key         String?
  count       Int?
  lastRequest BigInt?

  @@map("rateLimit")
}

/**
 * Rate-Limiting für die eigenen API-Routen (lib/rate-limit.ts) — bewusst
 * getrennt von der better-auth-eigenen `rateLimit`-Tabelle oben, die nur die
 * Auth-Endpunkte abdeckt. DB-gestützt statt prozesslokal, damit das Limit
 * über mehrere Instanzen hinweg gilt.
 */
model AppRateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

/// Persistente Dedupliziertung verarbeiteter Stripe-Webhook-Events (Audit-
/// Finding M14/R06) — Stripe kann dasselbe Event mehrfach zustellen (Retry
/// ohne rechtzeitige 2xx-Antwort). `id` ist die Stripe-Event-ID.
///
/// Zwei Phasen statt eines einzelnen Inserts: die Zeile wird VOR dem
/// eigentlichen Verarbeiten mit status=processing angelegt (beansprucht die
/// Event-ID) und erst NACH erfolgreichem Verarbeiten auf status=completed
/// gesetzt. Schlägt die Verarbeitung dazwischen fehl (z. B. kurzzeitiger
/// DB-Fehler), bleibt die Zeile auf "processing" stehen — ein Stripe-Retry
/// erkennt daran, dass die eigentliche Änderung NICHT abgeschlossen wurde,
/// und wiederholt sie, statt fälschlich `{deduplicated:true}` zurückzugeben.
/// Ein einzelnes Feld `processedAt` (immer beim Anlegen gesetzt) konnte diesen
/// Unterschied nicht abbilden.
model StripeWebhookEvent {
  id          String                   @id
  status      StripeWebhookEventStatus @default(processing)
  createdAt   DateTime                 @default(now())
  processedAt DateTime?

  @@index([processedAt])
  @@index([status])
}

enum StripeWebhookEventStatus {
  processing
  completed
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// Serverseitiger Nachweis der Cookie-Consent-Entscheidung (Art. 7 Abs. 1
/// DSGVO verlangt, dass der Verantwortliche eine wirksame Einwilligung
/// belegen kann). Das Cookie selbst (lib/consent.ts) bleibt die technische
/// Steuerung im Browser; dieser Datensatz ist der davon unabhaengige
/// Nachweis, der auch nach Cookie-Loeschung bestehen bleibt. Bewusst ohne
/// automatisches Purging (siehe Cron) - der Nachweiswert nimmt mit der Zeit
/// nicht ab.
model ConsentRecord {
  id            String   @id @default(cuid())
  userId        String?
  value         String
  bannerVersion String
  ipAddress     String   @default("")
  userAgent     String   @default("")
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Tenant {
  id                           String                              @id @default(cuid())
  slug                         String                              @unique
  name                         String
  country                      String                              @default("DE")
  timezone                     String                              @default("Europe/Berlin")
  size                         String?
  industry                     String?
  contactEmail                 String?
  logoUrl                      String?
  primaryColor                 String                              @default("#2A6FDB")
  plan                         TenantPlan                          @default(professional)
  billingCycle                 BillingCycle                        @default(monthly)
  stripeCustomerId             String?                             @unique
  stripeSubscriptionId         String?                             @unique
  stripePriceId                String?
  stripeSubscriptionStatus     String?
  stripeCurrentPeriodEnd       DateTime?
  stripeCancelAtPeriodEnd      Boolean                             @default(false)
  /// Erstellungszeitpunkt (`event.created`) des zuletzt tatsächlich
  /// angewendeten Subscription-Webhook-Events — verhindert, dass ein
  /// verspätet zugestelltes/außer der Reihe eintreffendes älteres Ereignis
  /// einen bereits neueren lokalen Stand überschreibt (Audit-Finding M14).
  stripeLastEventCreatedAt     DateTime?
  /// Über den Anlage-Assistenten erstellt: ohne abgeschlossenen Checkout
  /// gesperrt (lib/billing-access.ts). Ältere Mandanten bleiben `false`.
  billingRequired              Boolean                             @default(false)
  /// Mindestens eine Rechnung mit Betrag > 0 wurde bezahlt — entscheidet,
  /// ob eine fehlgeschlagene Zahlung eine Kulanzphase bekommt.
  stripeHasPaid                Boolean                             @default(false)
  /// `attempt_count` der aktuell offenen, fehlgeschlagenen Abo-Rechnung;
  /// bei bezahlter Rechnung wieder 0.
  stripeFailedPaymentAttempts  Int                                 @default(0)
  createdAt                    DateTime                            @default(now())
  updatedAt                    DateTime                            @updatedAt
  invitations                  TenantInvitation[]
  memberships                  TenantMembership[]
  roles                        TenantRole[]
  teams                        TenantTeam[]
  locations                    TenantLocation[]
  employees                    TenantEmployee[]
  vacationRequests             TenantVacationRequest[]
  wishFreeRequests             TenantWishFreeRequest[]
  timeCorrectionRequests       TenantTimeCorrectionRequest[]
  shiftOffers                  TenantShiftOffer[]
  shifts                       TenantShift[]
  shiftTemplates               TenantShiftTemplate[]
  shiftWeeks                   TenantShiftWeek[]
  files                        TenantFile[]
  fileFolders                  TenantFileFolder[]
  reminders                    TenantReminder[]
  contracts                    TenantEmployeeContract[]
  contractDetails              TenantEmployeeContractDetails[]
  payrollStatements            TenantPayrollStatement[]
  sicknessReports              TenantSicknessReport[]
  auditLogs                    TenantAuditLog[]
  locationActivities           TenantLocationActivity[]
  infoRequests                 TenantEmployeeInfoRequest[]
  employeeTimeline             TenantEmployeeTimeline[]
  employeeNotifications        TenantEmployeeNotification[]
  employeeFolderTemplates      TenantEmployeeFolderTemplate[]
  timeEntries                  TenantTimeEntry[]
  clockReminders               TenantTimeClockReminder[]
  reportRecipients             TenantReportRecipient[]
  settings                     TenantSettings?
  reminderSuggestionDismissals TenantReminderSuggestionDismissal[]
}

model TenantMembership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(EMPLOYEE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tenantId  String
  userId    String
  roleId    String?
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef   TenantRole?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([roleId])
  @@index([userId])
}

model TenantInvitation {
  id            String           @id @default(cuid())
  email         String
  role          InvitationRole   @default(EMPLOYEE)
  status        InvitationStatus @default(PENDING)
  token         String           @unique @default(cuid())
  expiresAt     DateTime?
  invitedByName String           @default("")
  acceptedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenantId      String
  /// Personalakte, für die eingeladen wurde (Einladung aus der Akte) — beim
  /// Annehmen wird genau diese verknüpft statt per E-Mail-Abgleich.
  employeeId    String?
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      TenantEmployee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([email])
  @@index([token])
  @@index([employeeId])
}

model TenantSettings {
  id                                        String   @id @default(cuid())
  taxId                                     String   @default("")
  defaultLocationId                         String   @default("")
  weekStart                                 String   @default("monday")
  workHours                                 String   @default("40 Stunden pro Woche")
  vacationDays                              Int      @default(30)
  shiftPresetsJson                          Json     @default("[]")
  shiftMinStaffing                          Int      @default(3)
  shiftBreakRule                            String   @default("30-6")
  /// Mindest-Ruhezeit zwischen zwei Schichten in Stunden (§5 ArbZG:
  /// gesetzliches Minimum 11h). Wird bei Schicht-Anlage/-Änderung geprüft.
  minRestHours                              Int      @default(11)
  /// Maximale Dauer einer einzelnen Schicht in Stunden (§3 ArbZG:
  /// grundsaetzlich 8h, verlaengerbar auf bis zu 10h bei Ausgleich
  /// innerhalb von 6 Monaten - 10 als praktikabler Default).
  maxShiftHours                             Int      @default(10)
  defaultOpeningHoursJson                   Json     @default("[]")
  employeeNumberRequired                    Boolean  @default(true)
  employeeNumberPrefix                      String   @default("MA-")
  employeeNumberSuffix                      String   @default("")
  archiveFormerEmployees                    Boolean  @default(true)
  mailNotifications                         Boolean  @default(true)
  inAppNotifications                        Boolean  @default(true)
  mobilePush                                Boolean  @default(false)
  deadlineAlerts                            Boolean  @default(true)
  absenceAlerts                             Boolean  @default(true)
  shiftAlerts                               Boolean  @default(true)
  digestTime                                String   @default("monday-0800")
  twoFactorRequired                         Boolean  @default(false)
  sessionTimeout                            Boolean  @default(true)
  auditRetentionMonths                      Int      @default(24)
  billingNotifications                      Boolean  @default(true)
  /// Zeiterfassung (Stempeluhr) fuer Mitarbeiter - siehe lib/time-tracking-service.ts.
  timeTrackingEnabled                       Boolean  @default(false)
  /// Pausen stempeln (Start/Stopp) erlaubt.
  timeTrackingBreaksEnabled                 Boolean  @default(true)
  /// Gesetzliche Mindestpause (§4 ArbZG: 30 Min. ab 6h, 45 Min. ab 9h)
  /// automatisch abziehen, wenn weniger Pause gestempelt wurde.
  timeTrackingAutoBreakDeduction            Boolean  @default(false)
  /// "always" = jederzeit einstempeln; "shift" = nur, wenn eine
  /// veroeffentlichte Schicht laeuft oder innerhalb von
  /// `timeTrackingClockInLeadMinutes` beginnt.
  timeTrackingClockInMode                   String   @default("always")
  timeTrackingClockInLeadMinutes            Int      @default(60)
  /// Push-Erinnerung zum Ein-/Ausstempeln (5 Min. nach Schichtbeginn/-ende).
  timeTrackingReminderPush                  Boolean  @default(true)
  /// Vergessene Stempelungen automatisch schliessen.
  timeTrackingAutoClockOut                  Boolean  @default(false)
  /// ... X Minuten nach dem Ende der zugeordneten Schicht (Ausstempelzeit = Schichtende).
  timeTrackingAutoClockOutAfterShiftMinutes Int      @default(60)
  /// ... bzw. ohne zugeordnete Schicht nach X Stunden ab Einstempeln.
  timeTrackingAutoClockOutMaxHours          Int      @default(12)
  /// In der App nur nach Scan eines Standort-QR-Codes (TenantLocation.clockQrToken)
  /// einstempeln. Gilt nicht fuer das Web-Dashboard.
  timeTrackingQrRequired                    Boolean  @default(false)
  /// Dasselbe getrennt fuers Ausstempeln (aus = Ausstempeln per Knopf).
  timeTrackingQrRequiredClockOut            Boolean  @default(false)
  createdAt                                 DateTime @default(now())
  updatedAt                                 DateTime @updatedAt
  tenantId                                  String   @unique
  companyAddressId                          String?  @unique
  companyAddress                            Address? @relation("TenantSettingsCompanyAddress", fields: [companyAddressId], references: [id], onDelete: SetNull)
  tenant                                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Address {
  id                    String          @id @default(cuid())
  street                String          @default("")
  houseNumber           String          @default("")
  postalCode            String          @default("")
  city                  String          @default("")
  careOf                String          @default("")
  country               String          @default("DE")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  tenantSettingsCompany TenantSettings? @relation("TenantSettingsCompanyAddress")
  tenantLocation        TenantLocation? @relation("TenantLocationAddress")

  @@index([country])
  @@index([postalCode, city])
}

/// Eigenes Modell statt der (mit Standort-/Firmenadressen geteilten)
/// `Address`-Tabelle: nur hier sind die Felder personenbezogen (Privat-/
/// Arbeitsadresse eines Mitarbeiters) — Verschlüsselung (lib/encryption.ts)
/// würde in der gemeinsamen Tabelle auch nicht-personenbezogene Standort-/
/// Firmenadressen mitverschlüsseln und deren `@@index`e unbrauchbar machen.
/// Migration `20260903000000_split_employee_address` kopiert bestehende
/// Adressen (gleiche IDs) aus `Address` hierher; Verschlüsselung selbst
/// erfolgt App-seitig beim nächsten Speichern (siehe `decryptField`s
/// Klartext-Passthrough für noch nicht verschlüsselte Altdaten).
model EmployeeAddress {
  id                    String          @id @default(cuid())
  street                String          @default("")
  houseNumber           String          @default("")
  postalCode            String          @default("")
  city                  String          @default("")
  careOf                String          @default("")
  country               String          @default("DE")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  tenantEmployeePrivate TenantEmployee? @relation("TenantEmployeePrivateAddress")
  tenantEmployeeWork    TenantEmployee? @relation("TenantEmployeeWorkAddress")
}

model TenantRole {
  id                 String                 @id @default(cuid())
  key                String
  name               String
  description        String                 @default("")
  isSystem           Boolean                @default(false)
  /// Ob Trägerinnen und Träger dieser Rolle in der Mitarbeiter-App den Tab
  /// "Alles" (Gesamtüberblick über Schichten, Anträge und Abwesenheiten des
  /// Betriebs) sehen. Bewusst ein eigenes Rollen-Flag statt an "shifts"
  /// gekoppelt: der Tab bündelt mehrere Bereiche, und ein Schichtplan-
  /// Leserecht allein soll noch keinen Betriebsüberblick öffnen.
  appOverviewEnabled Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships        TenantMembership[]
  permissions        TenantRolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantRolePermission {
  id             String           @id @default(cuid())
  area           String
  level          PermissionLevel  @default(none)
  scope          PermissionScope  @default(all)
  canDelete      Boolean          @default(false)
  canUploadFiles Boolean          @default(false)
  canEditFiles   Boolean          @default(false)
  canViewFiles   Boolean          @default(false)
  canViewAudit   Boolean          @default(false)
  /// Nur für area "locations"/"teams" gesetzt — deckt die in die Standort-/
  /// Team-Detailseite eingebettete Schichtansicht/-bearbeitung ab, ohne dafür
  /// zwei weitere Pseudo-Areas einzuführen (siehe PermissionArea.supportsAssignedScope).
  shiftsLevel    PermissionLevel?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  roleId         String
  role           TenantRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, area])
  @@index([area])
}

model TenantTeam {
  id             String             @id @default(cuid())
  key            String
  name           String
  description    String             @default("")
  locations      String             @default("")
  colorClassName String             @default("bg-[#C9622A]")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members        TenantTeamMember[]
  files          TenantFile[]
  fileFolders    TenantFileFolder[]
  reminders      TenantReminder[]
  shifts         TenantShift[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantTeamMember {
  id         String         @id @default(cuid())
  employeeId String
  initials   String
  name       String
  location   String
  role       String
  contract   String
  status     String         @default("on-duty")
  isLead     Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  teamId     String
  team       TenantTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee   TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@index([employeeId])
  @@index([teamId])
}

model TenantLocation {
  id                 String                   @id @default(cuid())
  key                String
  kind               String
  name               String
  addressId          String?                  @unique
  employeeCount      Int                      @default(0)
  activeToday        Int                      @default(0)
  shiftCount         Int                      @default(0)
  openPositions      Int                      @default(0)
  /// Kontakt-E-Mail des Standorts (unabhängig von der Standortleitung).
  contactEmail       String                   @default("")
  openingHoursJson   Json                     @default("[]")
  /// Mindestbesetzung pro Tag fuer DIESEN Standort. `null` = Vorgabe des
  /// Unternehmens (TenantSettings.shiftMinStaffing) gilt weiter -- so bleibt
  /// ein Standort ohne eigene Einstellung automatisch an der zentralen
  /// Vorgabe haengen, statt sie beim Anlegen einmalig zu kopieren.
  shiftMinStaffing   Int?
  /// Für die Feiertagsberechnung (lib/german-holidays.ts). `null` = nur die
  /// neun bundeseinheitlichen Feiertage gelten für diesen Standort.
  bundesland         Bundesland?
  utilization        String                   @default("0%")
  utilizationCaption String                   @default("")
  status             LocationStatus           @default(active)
  accentClassName    String                   @default("bg-ink")
  leadInitials       String                   @default("--")
  leadName           String                   @default("Keine Leitung")
  leadPhone          String                   @default("")
  leadEmail          String                   @default("")
  leadEmployeeId     String?
  /// Dauerhafter Stempel-QR-Code des Standorts (zum Ausdrucken/Aufhaengen) -
  /// zufaelliges Token, `null` = noch keiner erzeugt. Neu erzeugen macht den
  /// alten Ausdruck ungueltig. Siehe lib/time-clock-qr.ts.
  clockQrToken       String?                  @unique
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenantId           String
  address            Address?                 @relation("TenantLocationAddress", fields: [addressId], references: [id], onDelete: SetNull)
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Echte Fremdschlüssel-Referenz auf die Standortleitung (statt reinem
  /// Namensabgleich) — `leadName`/`leadInitials`/`leadPhone`/`leadEmail`
  /// bleiben als Anzeige-Schnappschuss bestehen und werden beim Speichern
  /// aus diesem Mitarbeiter aufgefrischt.
  leadEmployee       TenantEmployee?          @relation("TenantLocationLead", fields: [leadEmployeeId], references: [id], onDelete: SetNull)
  shifts             TenantShift[]
  storageFiles       TenantFile[]
  storageFileFolders TenantFileFolder[]
  members            TenantLocationMember[]
  activities         TenantLocationActivity[]
  clockInEntries     TenantTimeEntry[]        @relation("TimeEntryClockInLocation")
  clockOutEntries    TenantTimeEntry[]        @relation("TimeEntryClockOutLocation")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([leadEmployeeId])
}

/**
 * Standort-Roster: welche Mitarbeiter einem Standort zugeordnet sind (Namens-Snapshot, analog TenantTeamMember).
 */
model TenantLocationMember {
  id         String         @id @default(cuid())
  employeeId String
  initials   String
  name       String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  locationId String
  location   TenantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employee   TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([locationId, employeeId])
  @@index([employeeId])
  @@index([locationId])
}

model TenantLocationActivity {
  id         String         @id @default(cuid())
  actor      String
  text       String
  tone       String         @default("ink")
  createdAt  DateTime       @default(now())
  tenantId   String
  locationId String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location   TenantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, locationId, createdAt])
  @@index([locationId])
}

model TenantEmployee {
  id                          String                         @id @default(cuid())
  key                         String
  userId                      String?
  initials                    String
  name                        String
  employeeNumber              String
  birthDate                   String                         @default("")
  birthPlace                  String                         @default("")
  nationality                 String                         @default("")
  maritalStatus               String                         @default("")
  privateAddressId            String?                        @unique
  taxId                       String                         @default("")
  socialSecurityNumber        String                         @default("")
  healthInsurance             String                         @default("")
  iban                        String                         @default("")
  location                    String                         @default("")
  team                        String                         @default("")
  role                        String                         @default("")
  startDate                   String                         @default("")
  endDate                     String                         @default("")
  contract                    String                         @default("Unbefristet")
  weeklyHours                 String                         @default("")
  tenure                      String                         @default("")
  status                      EmployeeStatus                 @default(active)
  email                       String                         @default("")
  phone                       String                         @default("")
  workAddressId               String?                        @unique
  vacationRemaining           Int                            @default(0)
  vacationTotal               Int                            @default(30)
  vacationTaken               Int                            @default(0)
  /// Wochentage, an denen dieser Mitarbeiter regulär arbeitet — Grundlage für
  /// die Urlaubsverbrauchsberechnung (lib/vacation-service.ts), die seitdem
  /// individuelle Arbeitstage statt pauschal alle Kalendertage zählt (Audit-
  /// Finding M01). Default 5-Tage-Woche (Mo-Fr), das bisherige De-facto-
  /// Verhalten für alle noch nicht konfigurierten Mitarbeiter am nächsten.
  workDaysJson                Json                           @default("[\"Mo\",\"Di\",\"Mi\",\"Do\",\"Fr\"]")
  /// Aus dem Vorjahr übertragener, noch nicht verbrauchter Resturlaub (BUrlG
  /// §7 Abs. 3) — getrennt von `vacationTotal` des laufenden Jahres geführt,
  /// damit beim Jahreswechsel-Cronjob (lib/vacation-carryover.ts) nicht die
  /// laufende Anspruchszahl überschrieben wird.
  vacationCarryover           Int                            @default(0)
  /// Frist, zu der `vacationCarryover` gesetzlich verfällt (default 31.03.
  /// des Folgejahres) — greift nur, wenn `vacationCarryoverRemindedAt`
  /// rechtzeitig vorher gesetzt wurde (BAG 9 AZR 541/15: ohne dokumentierten
  /// Hinweis kein automatischer Verfall).
  vacationCarryoverExpiresAt  DateTime?
  /// Zeitpunkt, zu dem der/die Mitarbeiter:in nachweislich auf den drohenden
  /// Verfall von `vacationCarryover` hingewiesen wurde. `null` = noch nicht
  /// hingewiesen — der Cronjob darf dann NICHT automatisch verfallen lassen.
  vacationCarryoverRemindedAt DateTime?
  /// Manuelle Korrektur des Resturlaubs (Tage, +/-) unabhängig von Vertrag,
  /// genehmigten Anträgen und `vacationCarryover` — für Sonderfälle wie
  /// Alt-Fehler oder Kulanz, ohne die gesetzlich relevante Übertragslogik
  /// (BUrlG §7 Abs. 3) anzufassen. Geht additiv in `vacationRemaining` ein
  /// (lib/vacations.ts, computeVacationAccount).
  vacationManualCorrection    Int                            @default(0)
  /// String statt Json: Feldverschlüsselung (lib/encryption.ts) arbeitet nur
  /// auf Strings. Enthält weiterhin JSON (App-seitig via JSON.stringify/parse
  /// serialisiert), nur die Spalte selbst ist jetzt Text statt jsonb.
  emergencyContactsJson       String                         @default("[]")
  /// Zeitpunkt des Austritts (offboardEmployee), Startpunkt der Fristuhr für
  /// die Kategorie-1-Anonymisierung (lib/data-retention.ts). Getrennt von
  /// endDate (String, frei editierbar), damit die Frist nicht durch eine
  /// nachträgliche Korrektur von endDate verschoben werden kann. Bei
  /// reactivateEmployee wieder auf null gesetzt.
  offboardedAt                DateTime?
  /// Sperrt jede automatische Löschung/Anonymisierung für diesen Datensatz
  /// (z. B. laufender Rechtsstreit). Muss von Hand gesetzt/aufgehoben werden,
  /// beides mit Audit-Pflicht.
  legalHold                   Boolean                        @default(false)
  legalHoldReason             String                         @default("")
  /// Mutterschutz-Kennzeichnung (§ 5/§ 6 MuSchG, Beschäftigungsverbote
  /// Nacht/Sonntag) — nur über den eigenen "mutterschutz"-Berechtigungs-
  /// bereich sicht-/bearbeitbar (lib/roles.ts), nicht über das allgemeine
  /// "sensitiveData". Muss wie legalHold von Hand gesetzt/aufgehoben werden,
  /// beides mit Audit-Pflicht — kein automatischer Fristablauf.
  maternityProtectionActive   Boolean                        @default(false)
  /// Verschlüsselt wie birthDate/legalHoldReason (lib/encryption.ts) — z. B.
  /// für ein handschriftliches "geschützt bis ca. TT.MM.JJJJ".
  maternityProtectionNote     String                         @default("")
  /// App-/Dashboard-Zugang für diesen Betrieb gesperrt (nur das verknüpfte Konto, nicht die Akte).
  appAccessLockedAt           DateTime?
  appAccessLockReason         String                         @default("")
  /// Zeitpunkt, an dem Kategorie-1-Stammdaten automatisch anonymisiert wurden
  /// (siehe cron/cleanup). null = noch nicht anonymisiert.
  piiAnonymizedAt             DateTime?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  tenantId                    String
  privateAddress              EmployeeAddress?               @relation("TenantEmployeePrivateAddress", fields: [privateAddressId], references: [id], onDelete: SetNull)
  workAddress                 EmployeeAddress?               @relation("TenantEmployeeWorkAddress", fields: [workAddressId], references: [id], onDelete: SetNull)
  tenant                      Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                        User?                          @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitations                 TenantInvitation[]
  vacationRequests            TenantVacationRequest[]
  wishFreeRequests            TenantWishFreeRequest[]
  timeCorrectionRequests      TenantTimeCorrectionRequest[]
  shiftOffers                 TenantShiftOffer[]
  shifts                      TenantShift[]
  storageFiles                TenantFile[]
  storageFileFolders          TenantFileFolder[]
  contracts                   TenantEmployeeContract[]
  payrollStatements           TenantPayrollStatement[]
  sicknessReports             TenantSicknessReport[]
  infoRequests                TenantEmployeeInfoRequest[]
  timeline                    TenantEmployeeTimeline[]
  timeEntries                 TenantTimeEntry[]
  contractDetails             TenantEmployeeContractDetails?
  teamMemberships             TenantTeamMember[]
  locationMemberships         TenantLocationMember[]
  locationsLed                TenantLocation[]               @relation("TenantLocationLead")

  @@unique([tenantId, key])
  @@unique([tenantId, employeeNumber])
  /// Ein Konto hängt pro Mandant an höchstens einer Personalakte.
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model TenantSicknessReport {
  id                String         @id @default(cuid())
  tenantId          String
  employeeId        String
  attachmentFileId  String?
  startDate         DateTime
  endDate           DateTime?
  status            SicknessStatus @default(open)
  certificateStatus String         @default("pending")
  reportChannel     String         @default("app")
  note              String         @default("")
  reportedById      String         @default("")
  reportedByName    String         @default("")
  closedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attachmentFile    TenantFile?    @relation(fields: [attachmentFileId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, startDate])
  @@index([employeeId])
}

/**
 * Persistierte In-App-Benachrichtigungen für den eingeloggten Mitarbeiter
 * (Mobile-App "Benachrichtigungen"-Screen) — anders als der berechnete,
 * admin-seitige `/api/me/notifications`-Feed (dort keine Persistenz, kein
 * Read-Status) sind das echte Zeilen mit `read`-Status, erzeugt über
 * `dispatchNotification` (lib/notifications/dispatch.ts) als dritter Kanal
 * neben E-Mail und Push.
 */
model TenantEmployeeNotification {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  category       String
  title          String
  detail         String
  read           Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  /// Optionale Referenz fuers Deep-Linking (z.B. "info-request" + die jeweilige ID) - leer, wenn die Benachrichtigung auf keine konkrete Entitaet zeigt.
  entityType     String    @default("")
  entityId       String    @default("")
  /// Sprachneutrale Quelle (NotificationMessage). title/detail sind beim Versand gerendert und damit in der Sprache, die der Empfaenger DAMALS eingestellt hatte; aus diesem Feld rendert der Posteingang bei jedem Abruf neu. Null bei Zeilen von vor dieser Aenderung - dann gelten title/detail.
  messagePayload Json?
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, read])
  @@index([tenantId, userId, createdAt])
}

model TenantAuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String   @default("")
  actorName  String
  action     String
  source     String
  entityType String
  entityId   String
  detail     String   @default("")
  ipAddress  String   @default("")
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([actorId])
}

model TenantFile {
  id                   String                     @id @default(cuid())
  tenantId             String
  employeeId           String?
  locationId           String?
  teamId               String?
  parentId             String?
  bucket               String                     @default("hr-documents")
  storageKey           String
  originalName         String
  displayName          String
  mimeType             String                     @default("application/octet-stream")
  sizeBytes            Int                        @default(0)
  extension            String                     @default("")
  folderSlug           String                     @default("allgemein")
  folderName           String                     @default("Allgemein")
  ownerName            String                     @default("HR")
  uploadedById         String                     @default("")
  uploadedByName       String                     @default("")
  documentType         String                     @default("Sonstiges")
  validFrom            String                     @default("")
  expiresAt            String                     @default("")
  reminderAt           String                     @default("")
  description          String                     @default("")
  tagsJson             Json                       @default("[]")
  assignedEmployeeId   String                     @default("")
  assignedEmployeeName String                     @default("")
  assignedLocationId   String                     @default("")
  assignedLocationName String                     @default("")
  accessRoleIdsJson    Json                       @default("[]")
  accessRoleNamesJson  Json                       @default("[]")
  accessUserIdsJson    Json                       @default("[]")
  accessUserNamesJson  Json                       @default("[]")
  status               FileStatus                 @default(active)
  /// Vor dem Mitarbeiter selbst verborgen: HR sieht die Datei weiterhin,
  /// die eigene Personalakte in App/"Mein Bereich" laesst sie aus.
  hiddenFromEmployee   Boolean                    @default(false)
  version              Int                        @default(1)
  provider             String                     @default("s3")
  deletedAt            DateTime?
  /// Gemeinsame Kennung einer Nutzer-Löschung (eine Datei oder ein ganzer
  /// Ordner samt Inhalt) — nur damit lässt sie sich innerhalb von 24 h als
  /// Ganzes rückgängig machen (lib/storage/storage.service.ts
  /// `restoreTenantFileDeletion`). `null` bei Löschungen ohne
  /// Rückgängig-Möglichkeit (Aufbewahrungsfristen, Kontolöschung, …).
  deletionBatchId      String?
  deletedByName        String                     @default("")
  /// Zeitpunkt, an dem eine neue Version hochgeladen und diese Version auf
  /// status=replaced gesetzt wurde. Grundlage fuer den 30-Tage-Purge-Lauf
  /// analog zu deletedAt bei status=deleted (siehe cron/cleanup).
  replacedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee             TenantEmployee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  location             TenantLocation?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  team                 TenantTeam?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent               TenantFile?                @relation("TenantFileVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions             TenantFile[]               @relation("TenantFileVersions")
  employeeContract     TenantEmployeeContract?
  payrollStatement     TenantPayrollStatement?
  sicknessAttachments  TenantSicknessReport[]
  infoRequestResponse  TenantEmployeeInfoRequest?

  infoRequestItem TenantEmployeeInfoRequestItem? @relation("InfoRequestItemFile")

  @@index([tenantId, status])
  @@index([tenantId, folderSlug])
  @@index([employeeId])
  @@index([locationId])
  @@index([teamId])
  @@index([assignedEmployeeId])
  @@index([assignedLocationId])
  @@index([parentId])
  @@index([bucket, storageKey])
  @@index([tenantId, deletionBatchId])
}

model TenantEmployeeContract {
  id                String         @id @default(cuid())
  title             String
  contractType      String         @default("Arbeitsvertrag")
  status            ContractStatus @default(draft)
  startDate         String
  endDate           String         @default("")
  probationEndDate  String         @default("")
  noticePeriod      String         @default("")
  position          String         @default("")
  department        String         @default("")
  workLocation      String         @default("")
  weeklyHours       String         @default("")
  compensation      String         @default("")
  vacationDays      Int            @default(0)
  terminationDate   String         @default("")
  terminationReason String         @default("")
  notes             String         @default("")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenantId          String
  employeeId        String
  fileId            String         @unique
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  file              TenantFile     @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, status])
  @@index([employeeId, startDate])
