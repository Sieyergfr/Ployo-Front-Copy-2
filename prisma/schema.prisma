generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  name          String
  email         String             @unique
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  accounts      Account[]
  memberships   TenantMembership[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Tenant {
  id            String             @id @default(cuid())
  slug          String             @unique
  name          String
  country       String             @default("DE")
  timezone      String             @default("Europe/Berlin")
  size          String?
  industry      String?
  contactEmail  String?
  logoUrl       String?
  primaryColor  String             @default("#2A6FDB")
  plan          String             @default("professional")
  billingCycle  String             @default("monthly")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  invitations   TenantInvitation[]
  memberships   TenantMembership[]
  roles         TenantRole[]
  teams         TenantTeam[]
  locations     TenantLocation[]
  employees     TenantEmployee[]
  vacationRequests TenantVacationRequest[]
  wishFreeRequests TenantWishFreeRequest[]
  shifts       TenantShift[]
  files        TenantFile[]
  fileFolders  TenantFileFolder[]
  reminders    TenantReminder[]
  contracts    TenantEmployeeContract[]
  sicknessReports TenantSicknessReport[]
  auditLogs     TenantAuditLog[]
  settings     TenantSettings?
}

model TenantMembership {
  id        String     @id @default(cuid())
  role      String     @default("EMPLOYEE")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenantId  String
  userId    String
  roleId    String?
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef   TenantRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([roleId])
  @@index([userId])
}

model TenantInvitation {
  id        String   @id @default(cuid())
  email     String
  role      String   @default("EMPLOYEE")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([email])
}

model TenantSettings {
  id                         String   @id @default(cuid())
  taxId                      String   @default("")
  defaultLocationId          String   @default("")
  weekStart                  String   @default("monday")
  workHours                  String   @default("40 Stunden pro Woche")
  vacationDays               Int      @default(30)
  employeeNumberRequired     Boolean  @default(true)
  archiveFormerEmployees     Boolean  @default(true)
  mailNotifications          Boolean  @default(true)
  inAppNotifications         Boolean  @default(true)
  mobilePush                 Boolean  @default(false)
  deadlineAlerts             Boolean  @default(true)
  absenceAlerts              Boolean  @default(true)
  shiftAlerts                Boolean  @default(true)
  digestTime                 String   @default("monday-0800")
  twoFactorRequired          Boolean  @default(false)
  sessionTimeout             Boolean  @default(true)
  auditRetentionMonths       Int      @default(24)
  billingNotifications       Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  tenantId                   String   @unique
  companyAddressId           String?  @unique
  companyAddress             Address? @relation("TenantSettingsCompanyAddress", fields: [companyAddressId], references: [id], onDelete: SetNull)
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Address {
  id                         String          @id @default(cuid())
  street                     String          @default("")
  houseNumber                String          @default("")
  postalCode                 String          @default("")
  city                       String          @default("")
  careOf                     String          @default("")
  country                    String          @default("DE")
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  tenantSettingsCompany      TenantSettings? @relation("TenantSettingsCompanyAddress")
  tenantLocation             TenantLocation? @relation("TenantLocationAddress")
  tenantEmployeePrivate      TenantEmployee? @relation("TenantEmployeePrivateAddress")
  tenantEmployeeWork         TenantEmployee? @relation("TenantEmployeeWorkAddress")

  @@index([country])
  @@index([postalCode, city])
}

model TenantRole {
  id          String                 @id @default(cuid())
  key         String
  name        String
  description String                 @default("")
  isSystem    Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]
  permissions TenantRolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantRolePermission {
  id        String     @id @default(cuid())
  area      String
  level     String     @default("none")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  roleId    String
  role      TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, area])
  @@index([area])
}

model TenantTeam {
  id             String             @id @default(cuid())
  key            String
  name           String
  description    String             @default("")
  locations      String             @default("")
  colorClassName String             @default("bg-[#C9622A]")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members        TenantTeamMember[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantTeamMember {
  id         String     @id @default(cuid())
  employeeId String
  initials   String
  name       String
  location   String
  role       String
  contract   String
  status     String     @default("on-duty")
  isLead     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  teamId     String
  team       TenantTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@index([employeeId])
  @@index([teamId])
}

model TenantLocation {
  id                 String   @id @default(cuid())
  key                String
  kind               String
  name               String
  addressId          String?  @unique
  employeeCount      Int      @default(0)
  activeToday        Int      @default(0)
  shiftCount         Int      @default(0)
  openPositions      Int      @default(0)
  utilization        String   @default("0%")
  utilizationCaption String   @default("")
  status             String   @default("active")
  accentClassName    String   @default("bg-ink")
  leadInitials       String   @default("--")
  leadName           String   @default("Keine Leitung")
  leadPhone          String   @default("")
  leadEmail          String   @default("")
  teamJson           String   @default("[]")
  activityJson       String   @default("[]")
  fileFoldersJson    String   @default("[]")
  filesJson          String   @default("[]")
  shiftPlanJson      String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenantId           String
  address            Address? @relation("TenantLocationAddress", fields: [addressId], references: [id], onDelete: SetNull)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shifts             TenantShift[]
  storageFiles       TenantFile[]
  storageFileFolders TenantFileFolder[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantEmployee {
  id                       String   @id @default(cuid())
  key                      String
  initials                 String
  name                     String
  employeeNumber           String
  birthDate                String   @default("")
  birthPlace               String   @default("")
  nationality              String   @default("")
  maritalStatus            String   @default("")
  privateAddressId         String?  @unique
  taxId                    String   @default("")
  socialSecurityNumber     String   @default("")
  healthInsurance          String   @default("")
  iban                     String   @default("")
  location                 String   @default("")
  team                     String   @default("")
  role                     String   @default("")
  startDate                String   @default("")
  contract                 String   @default("Unbefristet")
  weeklyHours              String   @default("")
  tenure                   String   @default("")
  status                   String   @default("active")
  email                    String   @default("")
  phone                    String   @default("")
  workAddressId            String?  @unique
  vacationRemaining        Int      @default(0)
  vacationTotal            Int      @default(30)
  vacationTaken            Int      @default(0)
  documentsJson            String   @default("[]")
  fileFoldersJson          String   @default("[]")
  filesJson                String   @default("[]")
  emergencyContactsJson    String   @default("[]")
  payrollStatementsJson    String   @default("[]")
  infoRequestsJson         String   @default("[]")
  shiftsJson               String   @default("[]")
  timelineJson             String   @default("[]")
  contractDetailsJson      String   @default("{}")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenantId                 String
  privateAddress           Address? @relation("TenantEmployeePrivateAddress", fields: [privateAddressId], references: [id], onDelete: SetNull)
  workAddress              Address? @relation("TenantEmployeeWorkAddress", fields: [workAddressId], references: [id], onDelete: SetNull)
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vacationRequests         TenantVacationRequest[]
  wishFreeRequests         TenantWishFreeRequest[]
  shifts                   TenantShift[]
  storageFiles             TenantFile[]
  storageFileFolders       TenantFileFolder[]
  contracts                TenantEmployeeContract[]
  sicknessReports          TenantSicknessReport[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantSicknessReport {
  id                String         @id @default(cuid())
  tenantId          String
  employeeId        String
  startDate         DateTime
  endDate           DateTime?
  status            String         @default("open")
  certificateStatus String         @default("pending")
  reportChannel     String         @default("app")
  note              String         @default("")
  reportedById      String         @default("")
  reportedByName    String         @default("")
  closedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, startDate])
  @@index([employeeId])
}

model TenantAuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String   @default("")
  actorName  String
  action     String
  source     String
  entityType String
  entityId   String
  detail     String   @default("")
  ipAddress  String   @default("")
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([actorId])
}

model TenantFile {
  id           String          @id @default(cuid())
  tenantId     String
  employeeId   String?
  locationId   String?
  parentId     String?
  bucket       String          @default("hr-documents")
  storageKey   String
  originalName String
  displayName  String
  mimeType     String          @default("application/octet-stream")
  sizeBytes    Int             @default(0)
  extension    String          @default("")
  folderSlug   String          @default("allgemein")
  folderName   String          @default("Allgemein")
  ownerName    String          @default("HR")
  uploadedById String          @default("")
  uploadedByName String        @default("")
  documentType String          @default("Sonstiges")
  validFrom    String          @default("")
  expiresAt    String          @default("")
  reminderAt   String          @default("")
  description  String          @default("")
  tagsJson     String          @default("[]")
  assignedEmployeeId String    @default("")
  assignedEmployeeName String  @default("")
  assignedLocationId String    @default("")
  assignedLocationName String  @default("")
  accessRoleIdsJson String     @default("[]")
  accessRoleNamesJson String   @default("[]")
  accessUserIdsJson String     @default("[]")
  accessUserNamesJson String   @default("[]")
  status       String          @default("active")
  version      Int             @default(1)
  provider     String          @default("s3")
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     TenantEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  location     TenantLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  parent       TenantFile?     @relation("TenantFileVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions     TenantFile[]    @relation("TenantFileVersions")
  employeeContract TenantEmployeeContract?

  @@index([tenantId, status])
  @@index([tenantId, folderSlug])
  @@index([employeeId])
  @@index([locationId])
  @@index([assignedEmployeeId])
  @@index([assignedLocationId])
  @@index([parentId])
  @@index([bucket, storageKey])
}

model TenantEmployeeContract {
  id                  String         @id @default(cuid())
  title               String
  contractType        String         @default("Arbeitsvertrag")
  status              String         @default("draft")
  startDate           String
  endDate             String         @default("")
  probationEndDate    String         @default("")
  noticePeriod        String         @default("")
  position            String         @default("")
  department          String         @default("")
  workLocation        String         @default("")
  weeklyHours         String         @default("")
  compensation        String         @default("")
  vacationDays        Int            @default(0)
  terminationDate     String         @default("")
  terminationReason   String         @default("")
  notes               String         @default("")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tenantId            String
  employeeId          String
  fileId              String         @unique
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee            TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  file                TenantFile     @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, status])
  @@index([employeeId, startDate])
}

model TenantFileFolder {
  id          String             @id @default(cuid())
  tenantId    String
  employeeId  String?
  locationId  String?
  parentId    String?
  scope       String             @default("tenant")
  name        String
  slug        String
  path        String
  ownerName   String             @default("HR")
  status      String             @default("active")
  locked      Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    TenantEmployee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  location    TenantLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  parent      TenantFileFolder?  @relation("TenantFileFolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    TenantFileFolder[] @relation("TenantFileFolderChildren")

  @@unique([tenantId, scope, path])
  @@index([tenantId, parentId])
  @@index([tenantId, status])
  @@index([employeeId])
  @@index([locationId])
}

model TenantReminder {
  id              String   @id @default(cuid())
  key             String
  title           String
  subject         String   @default("")
  category        String   @default("Allgemein")
  dueDate         String
  priority        String   @default("normal")
  status          String   @default("open")
  notes           String   @default("")
  linkedFilesJson String   @default("[]")
  completedAt     DateTime?
  createdById     String   @default("")
  createdByName   String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([priority])
}

model TenantShift {
  id           String          @id @default(cuid())
  key          String
  date         String
  weekday      String
  startTime    String
  endTime      String
  breakMinutes Int             @default(30)
  team         String          @default("")
  note         String          @default("")
  conflict     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenantId     String
  employeeId   String?
  locationId   String?
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     TenantEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  location     TenantLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([employeeId])
  @@index([locationId])
  @@index([date])
}

model TenantVacationRequest {
  id             String         @id @default(cuid())
  key            String
  startDate      String
  endDate        String
  days           Int            @default(1)
  status         String         @default("pending")
  note           String         @default("")
  decidedAt      DateTime?
  decidedBy      String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenantId       String
  employeeId     String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

model TenantWishFreeRequest {
  id           String         @id @default(cuid())
  key          String
  date         String
  status       String         @default("open")
  reason       String         @default("")
  rejectReason String         @default("")
  decidedAt    DateTime?
  decidedBy    String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenantId     String
  employeeId   String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}
