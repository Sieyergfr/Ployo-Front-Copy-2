/**
 * Persistierte In-App-Benachrichtigungen für den eingeloggten Mitarbeiter
 * (Mobile-App "Benachrichtigungen"-Screen) — anders als der berechnete,
 * admin-seitige `/api/me/notifications`-Feed (dort keine Persistenz, kein
 * Read-Status) sind das echte Zeilen mit `read`-Status, erzeugt über
 * `dispatchNotification` (lib/notifications/dispatch.ts) als dritter Kanal
 * neben E-Mail und Push.
 */
model TenantEmployeeNotification {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  category       String
  title          String
  detail         String
  read           Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  /// Optionale Referenz fuers Deep-Linking (z.B. "info-request" + die jeweilige ID) - leer, wenn die Benachrichtigung auf keine konkrete Entitaet zeigt.
  entityType     String    @default("")
  entityId       String    @default("")
  /// Sprachneutrale Quelle (NotificationMessage). title/detail sind beim Versand gerendert und damit in der Sprache, die der Empfaenger DAMALS eingestellt hatte; aus diesem Feld rendert der Posteingang bei jedem Abruf neu. Null bei Zeilen von vor dieser Aenderung - dann gelten title/detail.
  messagePayload Json?
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, read])
  @@index([tenantId, userId, createdAt])
}

model TenantAuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String   @default("")
  actorName  String
  action     String
  source     String
  entityType String
  entityId   String
  detail     String   @default("")
  ipAddress  String   @default("")
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([actorId])
}

model TenantFile {
  id                   String                     @id @default(cuid())
  tenantId             String
  employeeId           String?
  locationId           String?
  teamId               String?
  parentId             String?
  bucket               String                     @default("hr-documents")
  storageKey           String
  originalName         String
  displayName          String
  mimeType             String                     @default("application/octet-stream")
  sizeBytes            Int                        @default(0)
  extension            String                     @default("")
  folderSlug           String                     @default("allgemein")
  folderName           String                     @default("Allgemein")
  ownerName            String                     @default("HR")
  uploadedById         String                     @default("")
  uploadedByName       String                     @default("")
  documentType         String                     @default("Sonstiges")
  validFrom            String                     @default("")
  expiresAt            String                     @default("")
  reminderAt           String                     @default("")
  description          String                     @default("")
  tagsJson             Json                       @default("[]")
  assignedEmployeeId   String                     @default("")
  assignedEmployeeName String                     @default("")
  assignedLocationId   String                     @default("")
  assignedLocationName String                     @default("")
  accessRoleIdsJson    Json                       @default("[]")
  accessRoleNamesJson  Json                       @default("[]")
  accessUserIdsJson    Json                       @default("[]")
  accessUserNamesJson  Json                       @default("[]")
  status               FileStatus                 @default(active)
  /// Vor dem Mitarbeiter selbst verborgen: HR sieht die Datei weiterhin,
  /// die eigene Personalakte in App/"Mein Bereich" laesst sie aus.
  hiddenFromEmployee   Boolean                    @default(false)
  version              Int                        @default(1)
  provider             String                     @default("s3")
  deletedAt            DateTime?
  /// Zeitpunkt, an dem eine neue Version hochgeladen und diese Version auf
  /// status=replaced gesetzt wurde. Grundlage fuer den 30-Tage-Purge-Lauf
  /// analog zu deletedAt bei status=deleted (siehe cron/cleanup).
  replacedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee             TenantEmployee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  location             TenantLocation?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  team                 TenantTeam?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent               TenantFile?                @relation("TenantFileVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions             TenantFile[]               @relation("TenantFileVersions")
  employeeContract     TenantEmployeeContract?
  payrollStatement     TenantPayrollStatement?
  sicknessAttachments  TenantSicknessReport[]
  infoRequestResponse  TenantEmployeeInfoRequest?

  @@index([tenantId, status])
  @@index([tenantId, folderSlug])
  @@index([employeeId])
  @@index([locationId])
  @@index([teamId])
  @@index([assignedEmployeeId])
  @@index([assignedLocationId])
  @@index([parentId])
  @@index([bucket, storageKey])
}

model TenantEmployeeContract {
