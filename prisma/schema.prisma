/**
 * 1:1 manuell erfasste Vertragsdetails (Alt-Datenfluss neben dem Datei-Upload in TenantEmployeeContract).
 */
model TenantEmployeeContractDetails {
  id                  String         @id @default(cuid())
  linkedFileName      String         @default("Keine Vertragsdatei")
  linkedFileMeta      String         @default("Noch nicht hochgeladen")
  contractType        String         @default("")
  entryDate           String         @default("")
  exitDate            String         @default("")
  fixedTerm           String         @default("")
  probation           String         @default("")
  position            String         @default("")
  department          String         @default("")
  supervisor          String         @default("")
  workLocation        String         @default("")
  parties             String         @default("")
  compensation        String         @default("")
  compensationGross   String         @default("")
  workingTime         String         @default("")
  vacation            String         @default("")
  noticePeriod        String         @default("")
  collectiveAgreement String         @default("")
  clauses             String[]       @default([])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tenantId            String
  employeeId          String         @unique
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee            TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

