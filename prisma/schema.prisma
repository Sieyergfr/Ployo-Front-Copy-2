}

model TenantEmployeeInfoRequest {
  id              String                          @id @default(cuid())
  title           String
  message         String                          @default("")
  requestedBy     String
  dueAt           DateTime?
  fileRequested   Boolean                         @default(false)
  status          InfoRequestStatus               @default(open)
  responseMessage String                          @default("")
  respondedAt     DateTime?
  responseFileId  String?                         @unique
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  tenantId        String
  employeeId      String
  tenant          Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        TenantEmployee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  responseFile    TenantFile?                     @relation(fields: [responseFileId], references: [id], onDelete: SetNull)
  items           TenantEmployeeInfoRequestItem[]

  @@index([tenantId, employeeId, status])
  @@index([employeeId, createdAt])
}

/**
 * Einzelnes Element einer mehrteiligen Info-Anfrage (M7): ein Dokument oder
 * eine Angabe, Pflicht oder optional. Anfragen ohne Elemente funktionieren
 * wie bisher (Nachricht + optional eine Datei).
 */
model TenantEmployeeInfoRequestItem {
  id          String                    @id @default(cuid())
  requestId   String
  position    Int                       @default(0)
  /// "document" | "field"
  kind        String                    @default("document")
  label       String
  required    Boolean                   @default(true)
  /// "open" | "provided"
  status      String                    @default("open")
  /// Antwort bei einer Angabe.
  value       String                    @default("")
  fileId      String?                   @unique
  respondedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  request     TenantEmployeeInfoRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  file        TenantFile?               @relation("InfoRequestItemFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@index([requestId, position])
}

/**
 * Chronologischer Personalakte-Verlauf (Anlage, Vertrags-/Standort-/Rollen-/Statusänderungen).
 */
model TenantEmployeeTimeline {
  id         String         @id @default(cuid())
  title      String
  tone       String         @default("ink")
  createdAt  DateTime       @default(now())
  tenantId   String
  employeeId String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, createdAt])
  @@index([employeeId])
}

model TenantPayrollStatement {
  id            String                 @id @default(cuid())
  period        String
  issuedAt      DateTime               @default(now())
  gross         String                 @default("")
  net           String                 @default("")
  status        PayrollStatementStatus @default(available)
  /// Erster Abruf durch den Mitarbeiter selbst ("gesehen"); `null` = noch nicht geöffnet.
  firstViewedAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  tenantId      String
  employeeId    String
  fileId        String                 @unique
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      TenantEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  file          TenantFile             @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@index([employeeId, period])
}

model TenantFileFolder {
  id                     String                        @id @default(cuid())
  tenantId               String
  employeeId             String?
  locationId             String?
  teamId                 String?
  parentId               String?
  /// Ordnervorlage, aus der der Ordner entstanden ist (lib/employee-folder-templates.ts).
  templateId             String?
  scope                  String                        @default("tenant")
  name                   String
  slug                   String
  path                   String
  ownerName              String                        @default("HR")
  status                 FileFolderStatus              @default(active)
  locked                 Boolean                       @default(false)
  /// Ordner (inkl. Inhalt) vor dem Mitarbeiter selbst verborgen.
  hiddenFromEmployee     Boolean                       @default(false)
  pinHash                String?
  /// Oben in der Ablage angeheftet (nur zentrale Ordner).
  pinned                 Boolean                       @default(false)
  /// Nur diese Rollen (plus Inhaber/Admin/HR) sehen den Ordner samt Inhalt und
  /// Unterordnern; leer = alle mit Datei-Berechtigung (bisheriges Verhalten).
  accessRoleIdsJson      Json                          @default("[]")
  /// Zentraler Ordner für Mitarbeitende freigegeben (lesen/herunterladen in
  /// "Mein Bereich" bzw. der App) — optional eingeschränkt auf Teams/Standorte.
  sharedWithEmployees    Boolean                       @default(false)
  visibleTeamIdsJson     Json                          @default("[]")
  visibleLocationIdsJson Json                          @default("[]")
  /// Vom Nutzer gelöscht (status "inactive") — siehe TenantFile.deletionBatchId.
  deletedAt              DateTime?
  deletionBatchId        String?
  deletedByName          String                        @default("")
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  tenant                 Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee               TenantEmployee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  location               TenantLocation?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  team                   TenantTeam?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent                 TenantFileFolder?             @relation("TenantFileFolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children               TenantFileFolder[]            @relation("TenantFileFolderChildren")
  template               TenantEmployeeFolderTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([tenantId, scope, path])
  @@index([tenantId, deletionBatchId])
  @@index([tenantId, parentId])
  @@index([tenantId, status])
  @@index([employeeId])
  @@index([locationId])
  @@index([teamId])
  @@index([templateId])
}

/// Ordnervorlage für Mitarbeiter-Personalakten ("Unter Mitarbeiter-Seite
/// Ordnervorlagen erstellen können, jeder Mitarbeiter hat dann automatisch
/// einen Ordner x"). Beim Anlegen wird der Ordner sofort für alle
/// bestehenden Mitarbeiter erzeugt (siehe `createEmployeeFolderTemplate` in
/// lib/employee-folder-templates.ts); neue Mitarbeiter bekommen ihn beim
/// Anlegen automatisch mit (siehe `createTenantEmployeeRecord`).
model TenantEmployeeFolderTemplate {
  id        String             @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime           @default(now())
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folders   TenantFileFolder[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TenantReminder {
  id               String           @id @default(cuid())
  key              String
  title            String
  subject          String           @default("")
  category         String           @default("Allgemein")
  dueDate          String
  priority         ReminderPriority @default(normal)
  status           ReminderStatus   @default(open)
  notes            String           @default("")
  linkedFilesJson  Json             @default("[]")
  /// Echte Verknüpfung ("employee" | "team" | "location") — `subject` bleibt der Anzeigetext.
  subjectType      String           @default("")
  subjectId        String           @default("")
  /// Zuständige Person (User-ID eines Mitglieds), leer = niemand.
  ownerUserId      String           @default("")
  /// "none" | "weekly" | "monthly" | "quarterly" | "yearly" — beim Erledigen wird die nächste angelegt.
  recurrence       String           @default("none")
  /// Tage vor Fälligkeit, ab denen die Erinnerung in Glocke/Digest erscheint.
  remindDaysBefore Int              @default(7)
  /// [{ id, label, done }]
  checklistJson    Json             @default("[]")
  /// Aus einem Vorschlag übernommen (z. B. "probation:<employeeId>:<date>").
  suggestionKey    String           @default("")
  completedAt      DateTime?
  createdById      String           @default("")
  createdByName    String           @default("")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenantId         String
  teamId           String?
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team             TenantTeam?      @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@index([teamId])
  @@index([tenantId, dueDate])
  @@index([priority])
}

/// Vom Nutzer ignorierte Fristen-Vorschläge der Erinnerungsseite.
model TenantReminderSuggestionDismissal {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model TenantShift {
  id           String             @id @default(cuid())
  key          String
  date         String
  weekday      Weekday
  startTime    String
  endTime      String
  breakMinutes Int                @default(30)
  team         String             @default("")
  note         String             @default("")
  conflict     Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenantId     String
  employeeId   String?
  locationId   String?
  /// Team der Schicht. `team` bleibt als Anzeige-/Schnappschuss-Text daneben
  /// (Vorlagen, veröffentlichte Wochen, App-Contract `team: string`).
  teamId       String?
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     TenantEmployee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  location     TenantLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  teamRef      TenantTeam?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  offers       TenantShiftOffer[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([employeeId])
  @@index([locationId])
  @@index([date])
  @@index([teamId])
}

/**
 * Angebot einer Schicht an einen Mitarbeiter (Vertretung oder offene Schicht).
 * Wer zuerst annimmt, bekommt die Schicht; die übrigen offenen Angebote
 * derselben Schicht werden dabei geschlossen.
 */
model TenantShiftOffer {
  id                 String         @id @default(cuid())
  tenantId           String
  shiftId            String
  /// Angefragte Person.
  employeeId         String
  /// Bisher eingeteilte Person (Vertretungsfall) — `null` bei einer offenen Schicht.
  /// Annehmen klappt nur, solange die Schicht noch so eingeteilt ist.
  replacedEmployeeId String?
  /// "pending" | "accepted" | "declined" | "closed"
  status             String         @default("pending")
  createdBy          String         @default("")
  respondedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift              TenantShift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee           TenantEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([shiftId])
  @@index([employeeId, status])
}

/**
 * Wiederverwendbares Wochenmuster (Wochentag/Zeiten/Team, ohne feste Mitarbeiterzuordnung).
 */
model TenantShiftTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  entriesJson Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

/**
 * Veröffentlichungsstatus einer Planungswoche. Fehlt die Zeile für ein
 * (tenantId, year, week), gilt die Woche implizit als Entwurf — es wird
 * keine Zeile pro Woche vorab angelegt, nur beim ersten Veröffentlichen.
 */
model TenantShiftWeek {
  id                      String          @id @default(cuid())
  tenantId                String
  year                    Int
  week                    Int
  status                  ShiftWeekStatus @default(draft)
  publishedAt             DateTime?
  publishedBy             String          @default("")
  /// Schnappschuss { employeeId: Anzahl Schichten } zum Zeitpunkt der letzten
  /// Veroeffentlichung dieser Woche -- ermoeglicht bei erneutem
  /// Veroeffentlichen zu erkennen, fuer welche Mitarbeiter sich seitdem
  /// wirklich etwas geaendert hat (Anzahl weicht ab, oder eine ihrer
  /// Schichten wurde seit dem letzten Veroeffentlichen angelegt/bearbeitet), statt jedes Mal
  /// alle erneut zu benachrichtigen.
  employeeShiftCountsJson Json            @default("{}")
  /// Schnappschuss aller veroeffentlichten Schichten dieser Woche (Feldform
  /// entspricht MyShift in lib/shift-service.ts) -- der Self-Service
  /// (getMyShiftsForCurrentWeek) zeigt Mitarbeitern ausschliesslich diesen
  /// Stand, nicht die live bearbeiteten TenantShift-Zeilen. Aenderungen an
  /// bereits veroeffentlichten Wochen werden fuer Mitarbeiter dadurch erst mit
  /// dem naechsten Veroeffentlichen sichtbar.
  publishedShiftsJson     Json            @default("[]")
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  tenant                  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, week])
  @@index([tenantId])
}

model TenantVacationRequest {
  id         String                @id @default(cuid())
  key        String
  startDate  String
  endDate    String
  days       Int                   @default(1)
  status     VacationRequestStatus @default(pending)
  note       String                @default("")
  decidedAt  DateTime?
  decidedBy  String                @default("")
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  tenantId   String
  employeeId String
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   TenantEmployee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

model TenantWishFreeRequest {
  id           String                @id @default(cuid())
  key          String
  date         String
  status       WishFreeRequestStatus @default(open)
  reason       String                @default("")
  rejectReason String                @default("")
  decidedAt    DateTime?
  decidedBy    String                @default("")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tenantId     String
  employeeId   String
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     TenantEmployee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

/**
 * Eigenes, cookie-freies Seitenaufruf-Tracking für die öffentlichen
 * Marketing-/Rechtsseiten (Landingpage, Login/Registrierung, Impressum/
 * Datenschutz/AGB/Kontakt) — keine Nutzer-ID, keine IP, kein Consent nötig,
 * da anonym und ohne Personenbezug (s. lib/analytics.ts). Bewusst kein
 * Dritt-Tool: schreibt in dieselbe Datenbank statt Daten an Google/Meta o. Ä.
 * abzugeben.
 */
/**
 * Ein gestempelter Arbeitsblock (Einstempeln bis Ausstempeln). Zeitpunkte
 * setzt ausschliesslich der Server. Hoechstens ein offener Eintrag
 * (`clockOutAt IS NULL`) je Mitarbeiter - erzwungen in
 * lib/time-tracking-service.ts, das jede Stempelaktion unter einer
 * Zeilensperre (`SELECT ... FOR UPDATE`) auf den Mitarbeiter ausfuehrt.
 */
model TenantTimeEntry {
  id                   String                        @id @default(cuid())
  tenantId             String
  employeeId           String
  clockInAt            DateTime
  clockOutAt           DateTime?
  /// ID des Eintrags aus `TenantShiftWeek.publishedShiftsJson`, "" ohne Schicht.
  shiftId              String                        @default("")
  plannedStartAt       DateTime?
  plannedEndAt         DateTime?
  shiftLocation        String                        @default("")
  /// Standort, dessen QR-Code beim Einstempeln (bzw. optional beim Ausstempeln) gescannt wurde (nur App).
  /// Kann vom Schicht-Standort abweichen; der Name bleibt als Schnappschuss
  /// erhalten, auch wenn der Standort spaeter umbenannt/geloescht wird.
  clockInLocationId    String?
  clockInLocationName  String                        @default("")
  clockOutLocationId   String?
  clockOutLocationName String                        @default("")
  /// "app" | "web" | "manual" (von der Verwaltung nachgetragen)
  source               String                        @default("app")
  /// Vom Cron automatisch ausgestempelt (vergessenes Ausstempeln).
  autoClosed           Boolean                       @default(false)
  /// Korrigierte Pausendauer - ersetzt die gestempelten Pausen in der Berechnung.
  breakMinutesOverride Int?
  /// Grund der letzten Korrektur bzw. Notiz zum manuellen Eintrag.
  note                 String                        @default("")
  correctedAt          DateTime?
  correctedBy          String                        @default("")
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  tenant               Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee             TenantEmployee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockInLocation      TenantLocation?               @relation("TimeEntryClockInLocation", fields: [clockInLocationId], references: [id], onDelete: SetNull)
  clockOutLocation     TenantLocation?               @relation("TimeEntryClockOutLocation", fields: [clockOutLocationId], references: [id], onDelete: SetNull)
  breaks               TenantTimeBreak[]
  correctionRequests   TenantTimeCorrectionRequest[]

  @@index([tenantId, clockInAt])
  @@index([employeeId, clockInAt])
}

/**
 * Korrekturantrag eines Mitarbeiters zu einem Arbeitstag ("Zeit korrigieren"):
 * gewünschtes Kommen/Gehen + Grund, entschieden von der Teamleitung bzw.
 * Verwaltung (timeTracking:write). Mit `timeEntryId` bezieht er sich auf einen
 * vorhandenen Eintrag, ohne auf einen fehlenden Tag (wird beim Genehmigen
 * nachgetragen). Status: pending | approved | rejected | withdrawn.
 */
model TenantTimeCorrectionRequest {
  id                    String           @id @default(cuid())
  tenantId              String
  employeeId            String
  timeEntryId           String?
  /// Kalendertag (Ortszeit des Betriebs), YYYY-MM-DD.
  date                  String
  /// Gewünschte Zeiten "HH:MM" (Ortszeit); Ende ≤ Beginn heißt über Mitternacht.
  requestedStartTime    String
  requestedEndTime      String
  /// Gewünschte Pausendauer; `null` = gestempelte bzw. gesetzliche Pause.
  requestedBreakMinutes Int?
  reason                String           @default("")
  status                String           @default("pending")
  decidedAt             DateTime?
  decidedBy             String           @default("")
  decisionNote          String           @default("")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee              TenantEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeEntry             TenantTimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([employeeId, date])
}

/**
 * Gestempelte Pause innerhalb eines Arbeitsblocks; hoechstens eine offene je Eintrag (gleiche Sperre wie oben).
 */
model TenantTimeBreak {
  id          String          @id @default(cuid())
  timeEntryId String
  startAt     DateTime
  endAt       DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  timeEntry   TenantTimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@index([timeEntryId])
}

/**
 * Versandprotokoll der Stempel-Erinnerungen - der Unique-Key verhindert, dass
 * der alle 5 Minuten laufende Cron dieselbe Erinnerung mehrfach verschickt.
 */
model TenantTimeClockReminder {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  /// "<Schicht-ID>@<Datum>"
  shiftRef   String
  /// "clock-in" | "clock-out"
  kind       String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shiftRef, kind])
  @@index([createdAt])
}

/**
 * Gespeicherte Empfänger für den Versand von Stunden-Reports
 * (app/(dashboard)/u/[tenant]/reports, lib/reports-service.ts). Bewusst eine
 * eigene, anfangs leere Liste je Betrieb — NICHT die E-Mail-Adressen der
 * Mitarbeiter: Reports gehen typischerweise an Lohnbuchhaltung/Steuerbüro.
 */
model TenantReportRecipient {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  createdBy String   @default("")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model PageView {
  id           String   @id @default(cuid())
  path         String
  referrerHost String   @default("")
  occurredAt   DateTime @default(now())

  @@index([path, occurredAt])
  @@index([occurredAt])
}
