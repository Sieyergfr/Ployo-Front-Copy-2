# Kopiere diese Datei nach `.env` und trage echte Werte ein. Niemals echte
# Secrets in DIESE Datei (.env.example) eintragen — sie wird committet.

# --- Datenbank -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/ployo"

# --- better-auth -------------------------------------------------------------
# Zufälliger, mindestens 32 Zeichen langer String (z. B. `openssl rand -hex 32`).
BETTER_AUTH_SECRET="changeme"
BETTER_AUTH_URL="http://localhost:3000"
# Kommagetrennte Liste zusätzlicher vertrauenswürdiger Origins (CORS/CSRF).
BETTER_AUTH_TRUSTED_ORIGINS=""

# --- OAuth: Google -----------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- OAuth: Apple (Sign in with Apple, auch für ployo-mobile) ----------------
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# PEM-Inhalt des .p8-Schlüssels, mit \n als Zeilenumbruch-Escapes.
APPLE_PRIVATE_KEY=""
APPLE_APP_BUNDLE_IDENTIFIER=""

# --- Cron-Endpunkte (app/api/cron/*) ------------------------------------------
# Bearer-Token, mit dem der externe Scheduler sich authentifiziert.
CRON_SECRET="changeme"

# --- Sentry --------------------------------------------------------------------
# Nur für den Build (Source-Map-Upload), nicht zur Laufzeit gelesen.
SENTRY_AUTH_TOKEN=""

# --- Verschlüsselung ruhender Felder (lib/field-encryption.ts) -----------------
FIELD_ENCRYPTION_KEY=""

# --- SMTP (Transaktions-E-Mails) ------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Ployo <no-reply@example.com>"
# Optional — Empfänger des Kontaktformulars (app/api/contact). Fällt sonst auf
# info@ployo.io zurück.
CONTACT_EMAIL=""

# --- S3-kompatibler Objektspeicher (Dokumente/Avatare) --------------------------
STORAGE_S3_REGION="de"
STORAGE_S3_ENDPOINT="https://s3.de.io.cloud.ovh.net/"
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_HR_DOCUMENTS_BUCKET=""

# --- Stripe (Abrechnung) ---------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_YEARLY=""
STRIPE_PRICE_PROFESSIONAL_MONTHLY=""
STRIPE_PRICE_PROFESSIONAL_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""

# --- Push-Benachrichtigungen (Mobile-App, lib/notifications/expo-push.ts) -------
# Optional — ohne Token funktioniert der Versand, nur mit niedrigerem Rate-Limit.
EXPO_ACCESS_TOKEN=""

# --- Lokale Entwicklung ------------------------------------------------------------
# Kommagetrennte Listen zusätzlicher erlaubter Dev-Origins/-Hosts (z. B. für
# Tests vom Handy im selben LAN gegen `next dev`).
DEV_LAN_ORIGINS=""
DEV_LAN_HOSTS=""
# Optional — lenkt einen Probe-Build in ein anderes Verzeichnis als `.next`
# (siehe next.config.ts), um die laufende Produktionsinstanz nicht anzufassen.
NEXT_BUILD_DIR=""
