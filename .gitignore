# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/.next

# lokale Probe-Builds/Scratch (Tailwind scannt sonst die Binär-Caches)
/tmp/
# Probe-Build (NEXT_BUILD_DIR) - nur zur Verifikation, wird nie ausgeliefert.
/.next-check/
/.next-review-release/
/out/
# scripts/deploy.sh sichert den vorherigen Build hierher, scripts/rollback.sh nutzt ihn.
/.next.backup/
# scripts/deploy.sh baut hierhin (atomarer Release-Wechsel statt in-place),
# .next ist ein Symlink auf das jeweils aktive Release-Verzeichnis darin.
/.next-releases/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local databases
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# design references (Figma/Devcanvas exports etc.) — not app code
/design/

# typescript
*.tsbuildinfo
next-env.d.ts
